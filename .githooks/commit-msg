#!/usr/bin/env bash
# Conventional Commits with a fixed scope list, 72-character lines, and no AI attribution.
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if grep -Eqi '^(co-authored-by:.*(claude|anthropic|copilot|cursor|openai)|.*generated with .*(claude|copilot|cursor))' "$msg_file"; then
  echo "commit-msg: remove the AI attribution line." >&2
  exit 1
fi

types='feat|fix|docs|test|refactor|chore|ci|build|perf|style'
scopes='repo|agents|decisions|spec|plan|api|mobile|db|infra'
if ! printf '%s' "$subject" | grep -Eq "^($types)(\(($scopes)\))?: [a-z0-9].*[^.]$"; then
  echo "commit-msg: subject must be 'type(scope): subject', lower case, no trailing period." >&2
  echo "  types:  $types" >&2
  echo "  scopes: $scopes" >&2
  exit 1
fi

if grep -v '^#' "$msg_file" | awk 'length > 72 { found = 1 } END { exit found ? 0 : 1 }'; then
  echo "commit-msg: every line must be at most 72 characters:" >&2
  grep -v '^#' "$msg_file" | awk 'length > 72' >&2
  exit 1
fi

if [ -n "$(sed -n '2p' "$msg_file")" ]; then
  echo "commit-msg: leave the second line blank." >&2
  exit 1
fi
exit 0
