# Every variable has a working default; no .env is needed for `docker compose up`.
HTTP_ADDR=:8080
DATABASE_URL=postgres://flash:flash@postgres:5432/flash?sslmode=disable
DB_MAX_CONNS=20
REDIS_ADDR=redis:6379
REDIS_TIMEOUT=50ms
CACHE_CAMPAIGN_TTL=5s
CACHE_CASHBACK_TTL=60s
# on | off. off serves reads from PostgreSQL only (deletes after commit still run).
CACHE_READS=on
# Whole milliseconds only (they are formatted into SET LOCAL).
LOCK_TIMEOUT=2s
STATEMENT_TIMEOUT=5s
# Read at the first seed only.
CAMPAIGN_BUDGET=10000000
# debug | info | warn | error
LOG_LEVEL=info
# demo-reset refuses unless this is exactly 1.
# FC_DEMO=1
